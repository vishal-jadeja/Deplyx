{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "*.json",
      "*.js",
      "*.ts",
      "!**/node_modules",
      "!**/dist",
      "!**/.next",
      "!**/.turbo",
      "!**/.trigger",
      "!**/coverage",
      "!**/pnpm-lock.yaml",
      "!packages/scanner/grammars",
      "!skills-lock.json",
      "!packages/db/drizzle"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "warn"
      },
      "suspicious": {
        "noConsole": {
          "level": "warn",
          "options": { "allow": ["warn", "error"] }
        }
      },
      "style": {
        "useImportType": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/**", "!apps/web/src/trigger/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@deplyx/db/worker": "The worker DB client bypasses RLS and is cross-tenant by design. It may only be imported from apps/web/src/trigger/** (Trigger.dev tasks). Use withTenant() from '@deplyx/db' on the request path instead."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/trigger/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "next": "Trigger.dev task files run in the worker runtime, not the Next.js request runtime. Import only from packages/* here.",
                  "react": "Trigger.dev task files run in the worker runtime, not the Next.js request runtime. Import only from packages/* here.",
                  "react-dom": "Trigger.dev task files run in the worker runtime, not the Next.js request runtime. Import only from packages/* here."
                }
              }
            }
          }
        }
      }
    }
  ]
}
