# ============================================================================
# Deplyx — environment variables
# Copy to .env and fill in. See README.md for how to obtain each value.
# ============================================================================

# --- Database (Neon Postgres) ---------------------------------------------
# Owner/superuser connection string. Used ONLY by `pnpm db:role` and
# `pnpm db:migrate` (schema changes need owner privileges). NEVER used by
# the running app — the owner role bypasses RLS entirely.
DATABASE_URL="postgresql://neondb_owner:PASSWORD@HOST/neondb?sslmode=require"

# Application role connection string. RLS ENFORCED. Used by every
# request-path / user-facing query in apps/web, via the withTenant() helper.
APP_DATABASE_URL="postgresql://deplyx_app:PASSWORD@HOST/neondb?sslmode=require"

# Privileged role connection string. RLS BYPASSED. Used ONLY by Trigger.dev
# tasks (apps/web/src/trigger/**), which are legitimately cross-tenant
# (e.g. the feed-poll fan-out queries every tenant's repos). In practice this
# is the same neondb_owner credential as DATABASE_URL above — kept as a
# separate env var (not a shared reference) so the two roles can be split
# further later without touching call sites.
WORKER_DATABASE_URL="postgresql://neondb_owner:PASSWORD@HOST/neondb?sslmode=require"

# Password used by `pnpm db:role` when creating the deplyx_app / deplyx_worker
# roles for the first time. Not a connection string — just the secret.
APP_DB_PASSWORD="change-me"

# --- Redis (Upstash) --------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxx"

# --- Trigger.dev -------------------------------------------------------------
TRIGGER_SECRET_KEY="tr_dev_xxxx"
TRIGGER_PROJECT_ID="proj_xxxx"

# --- Auth.js (v5) ------------------------------------------------------------
# Used for user login (separate from the GitHub App identity below).
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_GITHUB_ID="github-oauth-app-client-id"
AUTH_GITHUB_SECRET="github-oauth-app-client-secret"

# --- GitHub App --------------------------------------------------------------
# Used for repo install, PR authoring, webhooks. Separate from the OAuth app
# above — see README for registration steps.
GITHUB_APP_ID="123456"
GITHUB_APP_SLUG="deplyx"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_APP_WEBHOOK_SECRET="change-me"

# --- Encryption (BYOK provider keys) -----------------------------------------
# 32 raw bytes, base64-encoded (e.g. `openssl rand -base64 32`). Used to
# AES-256-GCM encrypt user-supplied LLM API keys at rest. Never decrypted
# outside a Trigger.dev worker at call time.
ENCRYPTION_MASTER_KEY="base64-32-bytes"

# --- Misc ---------------------------------------------------------------------
NODE_ENV="development"
